{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/news",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/autonomous-publish",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/auto-publish",
      "schedule": "0 8 * * *"
    }
  ]
}
