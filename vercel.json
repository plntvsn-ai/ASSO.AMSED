{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/seo/robots"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/autonomous-publish",
      "schedule": "0 8 * * *"
    }
  ]
}
